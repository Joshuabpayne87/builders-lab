# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# Notion Configuration (Private - for Implementation Library)
NOTION_API_KEY=your_notion_integration_api_key
NOTION_DATABASE_ID=your_notion_database_id

# Public Notion Configuration (for Resources page)
# These can be the same as above or different depending on your setup
PUBLIC_NOTION_API_KEY=your_public_notion_api_key
PUBLIC_DATABASE_ID=your_public_database_id

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ghost Webhooks
GHOST_WEBHOOK_SECRET=your_ghost_webhook_secret
# Comma-separated list of Stripe price IDs allowed for paid access.
GHOST_ALLOWED_PRICE_IDS=price_1SkVjzKIXHZWJF6GSzqWaeFw

# Ghost Admin API (fallback for membership claim)
GHOST_ADMIN_API_URL=https://shift-arcade.ghost.io
GHOST_ADMIN_API_KEY=your_ghost_admin_api_key
